# ============================================================
# Variables de entorno para Salon Hair Agent
# ============================================================

# Clave secreta para firmar los tokens JWT.
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga_minimo_32_chars

# Contraseña interna del usuario de PostgreSQL.
DB_PASSWORD=cambia_esto_por_una_password_segura

# URL de la base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@localhost:5432/salon_db

# ============================================================
# Google OAuth (Calendario + Gmail)
# ============================================================
# Obtén estas credenciales en: https://console.cloud.google.com/apis/credentials

GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
ADMIN_EMAIL=tu_email@gmail.com
APP_URL=http://localhost:3000